# ==============================================================================
# YottaFlex Project .gitignore
# ==============================================================================

# 1. Virtual Environment (NEVER commit packages or local Python binaries)
.venv/
venv/
env/
ENV/

# 2. Python Cache and Bytecode (automatically generated by Python)
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# 3. SQLite Database Files & Temporary WAL Logs
# yottaflex.db can be recreated in 1 second via `python orchestrate.py --mode full`
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
yottaflex_backup.db

# 4. Testing & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/
*.log

# 5. Operating System & Editor Files (Windows / VS Code / Mac)
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# 6. Streamlit Secret Files
.streamlit/secrets.toml